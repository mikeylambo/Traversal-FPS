{
  "schemaVersion": 1,
  "requiredFiles": [
    "src/main.ts",
    "src/game/TraversalGame.ts",
    "src/world/contentValidation.ts",
    "index.html",
    "AGENTS.md"
  ],
  "requiredScripts": [
    "build",
    "check",
    "verify",
    "content:doctor",
    "audio:doctor",
    "test:regression"
  ],
  "declarations": [
    "web-runtime",
    "controller-ui",
    "touch-gameplay",
    "accessibility-settings",
    "semantic-audio",
    "content-validation",
    "campaign-persistence"
  ],
