{
  "name": "traversal-fps",
  "private": true,
  "version": "0.14.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:doctor": "tsx scripts/content-doctor.ts",
    "test:regression": "tsx scripts/regression-tests.ts",
    "build": "npm run content:doctor && npm run audio:doctor && npm run test:regression && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "verify": "npm run build",
    "certify:web": "npm run verify && slu-certify web",
    "certify:mobile": "npm run verify && slu-certify mobile",
    "certify:controller": "npm run verify && slu-certify controller",
    "certify:release": "npm run verify && slu-certify release",
    "setup:img2threejs": "powershell -ExecutionPolicy Bypass -File tools/setup-img2threejs.ps1",
    "audio:build": "tsx scripts/build-audio.ts",
    "audio:doctor": "tsx scripts/audio-doctor.ts"
  },
  "dependencies": {
    "@slu/web-shell": "github:mikeylambo/Web-Game-Shell-v1.02#750972a4292a0cf430ca9980671a84a61e83491e",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
